# ─── PROXIES (optional) ───────────────────────────────────────────────
# Option A: single rotating proxy (changes IP on every request)
# ROTATING_PROXY=http://user:pass@proxy.provider.com:8080

# Option B: comma-separated list (each worker gets one)
# PROXY_LIST=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080

# Leave blank for direct connection

# ─── AWS / DBQ S3 ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
